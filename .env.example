# Postgres (docker-compose default)
DATABASE_URL=postgres://newstrader:newstrader@localhost:5433/newstrader

# SEC EDGAR fair-access rules REQUIRE a User-Agent with contact info.
# Format: "Name email@example.com" — requests without it are 403'd.
EDGAR_USER_AGENT=

# Massive (ex-Polygon) Stocks Starter API key
MASSIVE_API_KEY=
# Base URL — api.polygon.io still serves during the Massive rebrand; override if docs change.
MASSIVE_BASE_URL=https://api.polygon.io

# Local raw-payload store directory (S3 is used when deployed)
RAW_STORE_DIR=./data/raw

# Finnhub free API key (earnings calendar). Optional — the calendar sync skips earnings without it.
FINNHUB_API_KEY=
