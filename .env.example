# Postgres (docker-compose default)
DATABASE_URL=postgres://newstrader:newstrader@localhost:5433/newstrader

# SEC EDGAR fair-access rules REQUIRE a User-Agent with contact info.
# Format: "Name email@example.com" — requests without it are 403'd.
EDGAR_USER_AGENT=

# Massive (ex-Polygon) Stocks Starter API key
MASSIVE_API_KEY=
# Base URL — api.polygon.io still serves during the Massive rebrand; override if docs change.
MASSIVE_BASE_URL=https://api.polygon.io

# Local raw-payload store directory (S3 is used when deployed)
RAW_STORE_DIR=./data/raw

# Finnhub free API key (earnings calendar). Optional — the calendar sync skips earnings without it.
FINNHUB_API_KEY=

# Anthropic API key — the M2 interpret stage (claude-sonnet-5). Required by
# `pnpm cli interpret` (except --dry-run and --mode cli); NEVER print or commit
# the value.
ANTHROPIC_API_KEY=

# Interpret transport: api (default) or cli.
#   api — Anthropic SDK + ANTHROPIC_API_KEY. The ONLY production mode: it sets
#         effort and max_tokens, enforces the schema at the API, and is replayable.
#   cli — the Claude Code CLI on your Claude subscription, so no key is needed.
#         DEV ONLY. It cannot set effort or max_tokens, appends our system prompt
#         to a Claude Code harness prompt we do not version, and carries ~25.7k
#         harness tokens per call (so cost_usd is inflated and the daily cap
#         trips early). Rows are stamped transport=cli with a ':cli' signal_key
#         and must be excluded from calibration and golden evals.
# Overridden per-run by `pnpm cli interpret --mode <api|cli>`.
LLM_TRANSPORT=

# Path to the `claude` executable for LLM_TRANSPORT=cli. Optional — defaults to
# whatever `claude` resolves to on PATH.
CLAUDE_CLI_PATH=

# Per-UTC-day LLM spend circuit breaker in USD (SUM of llm_signals.cost_usd).
# Optional — defaults to 5. The interpreter stops calling when the day's spend
# reaches this; earnings-season peak days are why it exists.
LLM_DAILY_SPEND_USD_CAP=
